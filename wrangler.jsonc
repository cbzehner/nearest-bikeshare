{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nearest-bikeshare",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-13",
  "vars": {
    "SHORTCUT_SHARE_URL": "https://www.icloud.com/shortcuts/bc39097b6e3c40e4966b73f5dc056a9a",
  },
  "ratelimits": [
    {
      "name": "NEAREST_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
    {
      "name": "ROUTING_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 40,
        "period": 60,
      },
    },
  ],
}
